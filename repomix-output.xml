                  <g class="eyes-sneaky">
                    <ellipse cx="23" cy="28" rx="4.5" ry="3.5" fill="#ffc4b5"/>
                    <circle cx="24" cy="29" r="1.8" fill="#18212c"/>
                    <circle cx="22.5" cy="27.5" r="0.8" fill="#ffffff"/>
                    <ellipse cx="41" cy="28" rx="4.5" ry="3.5" fill="#ffc4b5"/>
                    <circle cx="42" cy="29" r="1.8" fill="#18212c"/>
