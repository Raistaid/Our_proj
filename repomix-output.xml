    } else if (form === 'phone') {
      drawPhone(ctx, level, zone, p, t);
      if (t !== null && t < PHONE_IN + PHONE_BUZZ) animating = true;
    } else if (form === 'tag') {
      drawTag(ctx, level, zone, p, t);
      if (t !== null && t < TAG_SWING) animating = true;
    } else if (form === 'badge') {
      drawBadge(ctx, level, zone, p, t);
