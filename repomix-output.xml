  ctx.restore();
}

// Badge glued onto the picture: it pops on and settles, always inside its rect.
function drawBadge(ctx, level, zone, p, t) {
  let scale = 1;
  let angle = -0.04;
  if (t !== null) {
    if (t < 0) return;
    const k = Math.min(1, t / BADGE_STICK);
    scale = 0.6 + 0.4 * easeOutBack(k);
    angle = -0.04 - 0.12 * (1 - k);
  }
