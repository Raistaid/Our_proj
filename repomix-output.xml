                  </g>
                  <g class="eyes-busted">
                    <path d="M20 26 L26 30 M26 26 L20 30" stroke="#ffc4b5" stroke-width="2.2" stroke-linecap="round"/>
                    <path d="M38 26 L44 30 M44 26 L38 30" stroke="#ffc4b5" stroke-width="2.2" stroke-linecap="round"/>
