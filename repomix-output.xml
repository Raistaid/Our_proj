  const img = assets.images[sticker.src];
  if (img) {
    const size = Math.min(p[2] * 0.82, p[3] * 0.9);
    ctx.drawImage(img, p[0] + (p[2] - size) / 2, p[1] + (p[3] - size) / 2, size, size);
